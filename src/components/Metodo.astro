---
// Seção 3: "O método NaLift". Textos em src/content/metodo.ts.
import { metodo } from '../content/metodo';

// Desenho line art de um rosto feminino, de frente, num traço fino em bordô.
// Cada ponto da lista acende uma região em rosé, "desenhada" com stroke-dashoffset.
const contorno =
  'M200 48 C268 48 318 100 318 184 C318 250 306 300 280 346 C256 388 228 418 200 422 C172 418 144 388 120 346 C94 300 82 250 82 184 C82 100 132 48 200 48 Z';

// Traços do desenho base (rosto, pescoço, sobrancelhas, olhos, nariz e lábios).
const base = [
  'M240 398 C242 440 246 470 256 510',
  'M160 398 C158 440 154 470 144 510',
  'M122 206 C142 190 168 190 184 200',
  'M278 206 C258 190 232 190 216 200',
  'M128 234 C144 246 166 246 180 234',
  'M272 234 C256 246 234 246 220 234',
  'M199 248 C197 280 191 298 185 309 C194 316 206 316 215 309',
  'M168 352 C181 341 192 343 200 348 C208 343 219 341 232 352',
  'M168 352 C183 372 217 372 232 352',
  // Orelhas: contorno simples saindo do rosto na altura dos olhos e voltando na altura da ponta do nariz, com uma
  // linha interna discreta.
  'M83 228 C66 218 56 246 60 272 C64 296 82 310 100 300',
  'M72 250 C67 262 69 280 79 292',
  'M317 228 C334 218 344 246 340 272 C336 296 318 310 300 300',
  'M328 250 C333 262 331 280 321 292',
];

// Ponto 2 ("Sustentação e reposicionamento"): setas VERTICAIS subindo pelas laterais do rosto, da mandíbula às têmporas
// (por fora das orelhas). Cada seta tem a haste (que leva o brilho rosé) e a ponta (dois traços finos, só no fio).
const setasLaterais = [
  { haste: 'M94 378 C64 358 42 318 40 268 C39 238 44 214 52 194', ponta: 'M45.1 199.8 L52 194 L53 202.9' },
  { haste: 'M70 396 C38 372 22 336 22 300 C22 282 24 268 28 256', ponta: 'M21.5 262.2 L28 256 L29.5 264.9' },
  { haste: 'M306 378 C336 358 358 318 360 268 C361 238 356 214 348 194', ponta: 'M354.9 199.8 L348 194 L347 202.9' },
  { haste: 'M330 396 C362 372 378 336 378 300 C378 282 376 268 372 256', ponta: 'M378.5 262.2 L372 256 L370.5 264.9' },
];

// Ponto 3 ("Mais camadas"): setas HORIZONTAIS em curva, do canto externo do olho e da maçã do rosto em direção às
// orelhas, levemente para cima e para trás (o vetor de um lifting). 3 de cada lado.
const setasLifting = [
  { haste: 'M127 247 C117 247 107 243 97 234', ponta: 'M99.7 241.5 L97 234 L104.8 235.9' },
  { haste: 'M150 283 C130 285 111 275 98 259', ponta: 'M99.5 266.9 L98 259 L105.4 262.1' },
  { haste: 'M160 317 C138 317 117 307 101 290', ponta: 'M103.1 297.7 L101 290 L108.6 292.6' },
  { haste: 'M273 247 C283 247 293 243 303 234', ponta: 'M300.3 241.5 L303 234 L295.2 235.9' },
  { haste: 'M250 283 C270 285 289 275 302 259', ponta: 'M300.5 266.9 L302 259 L294.6 262.1' },
  { haste: 'M240 317 C262 317 283 307 299 290', ponta: 'M296.9 297.7 L299 290 L291.4 292.6' },
];

// Ponto 4: mandíbula e contorno inferior, com a linha do maxilar.
const mandibula =
  'M308.75 272.5 C302.5 299 293 323 280 346 C256 388 228 418 200 422 C172 418 144 388 120 346 C107 323 97.5 299 91.25 272.5';
const maxilar =
  'M296 282 C291 304 282 326 268 346 C248 376 224 400 200 406 C176 400 152 376 132 346 C118 326 109 304 104 282';
---

<section class="secao metodo" id="metodo" aria-labelledby="metodo-titulo" data-ativa="1">
  <div class="secao__miolo metodo__grade">
    <div class="metodo__cab" data-reveal="escalonado">
      <h2 id="metodo-titulo">{metodo.titulo}</h2>
      {metodo.paragrafos.map((p) => <p class="metodo__texto">{p}</p>)}
    </div>

    <div class="metodo__painel">
    <!-- O rosto tem entrada própria (o desenho se traça): aqui o data-reveal só dispara o desenho. -->
    <figure class="metodo__rosto" data-reveal="gatilho">
      <svg viewBox="0 0 400 520" aria-hidden="true" focusable="false">
        <!-- Regiões acesas (por baixo do traço bordô) -->
        <g class="camada camada--1">
          <path class="glow tr" pathLength="1" d={contorno}></path>
        </g>
        <g class="camada camada--4">
          <path class="glow tr" pathLength="1" d={mandibula}></path>
          <path class="fio tr" pathLength="1" style="--i: 1" d={maxilar}></path>
        </g>
        <g class="camada camada--3">
          {setasLifting.map((s, i) => <path class="glow tr" pathLength="1" style={`--i: ${i % 3}`} d={s.haste} />)}
          {setasLifting.map((s, i) => <path class="fio tr" pathLength="1" style={`--i: ${(i % 3) + 1}`} d={s.haste} />)}
          {setasLifting.map((s, i) => <path class="fio tr ponta" pathLength="1" style={`--i: ${(i % 3) + 2}`} d={s.ponta} />)}
        </g>
        <g class="camada camada--2">
          {setasLaterais.map((s, i) => <path class="glow tr" pathLength="1" style={`--i: ${i % 2}`} d={s.haste} />)}
          {setasLaterais.map((s, i) => <path class="fio tr" pathLength="1" style={`--i: ${(i % 2) + 1}`} d={s.haste} />)}
          {setasLaterais.map((s, i) => <path class="fio tr ponta" pathLength="1" style={`--i: ${(i % 2) + 2}`} d={s.ponta} />)}
        </g>

        <!-- Desenho base em bordô -->
        <g class="base">
          <path class="tr-base" pathLength="1" d={contorno}></path>
          {base.map((d, i) => <path class="tr-base" pathLength="1" style={`--b: ${i}`} d={d} />)}
        </g>
      </svg>
      <figcaption class="metodo__legenda" aria-hidden="true"></figcaption>
    </figure>

    <!-- Só aparece no celular com JavaScript: botões redondos para trocar de ponto. -->
    <div class="metodo__botoes" role="group" aria-label="Pontos do método" data-reveal="subir">
      {
        metodo.pontos.map((ponto, i) => (
          <button
            type="button"
            class="metodo__botao"
            data-i={i}
            aria-pressed={i === 0 ? 'true' : 'false'}
            aria-label={`Ponto ${i + 1}: ${ponto.titulo}`}
          >
            {String(i + 1).padStart(2, '0')}
          </button>
        ))
      }
    </div>

    <div class="metodo__pontos" data-reveal="escalonado">
      <p class="metodo__dica">{metodo.dica}</p>
      {
        metodo.pontos.map((ponto, i) => (
          <details class="ponto" open>
            <summary>
              <span class="ponto__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="ponto__titulo">{ponto.titulo}</span>
              <span class="ponto__icone" aria-hidden="true" />
            </summary>
            <div class="ponto__corpo">
              <div class="ponto__corpo-interno">
                <p class="ponto__texto">{ponto.texto}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
    </div>

    <p class="metodo__destaque" data-reveal="subir">{metodo.destaque}</p>
  </div>
</section>

<script>
  import '../scripts/metodo.js';
</script>

<style>
  /* Celular: título e texto, rosto, lista, destaque. PC: rosto à direita da lista. */
  .metodo__grade {
    display: grid;
    gap: 2rem;
    grid-template-areas:
      'cab'
      'painel'
      'destaque';
  }

  /* Agrupa rosto, botões e pontos. No PC some (display: contents) e o grid da seção assume. */
  .metodo__painel {
    display: grid;
    gap: 2rem;
  }

  .metodo__botoes {
    display: none;
  }

  .metodo__cab {
    grid-area: cab;
  }

  .metodo__cab h2 {
    margin-bottom: 1rem;
    text-align: center;
  }

  .metodo__texto {
    max-width: 34rem; /* ~68 caracteres por linha (o ideal de leitura é até ~70) */
    margin-inline: auto;
    text-align: center;
  }

  .metodo__pontos {
    align-content: start;
  }

  .metodo__dica {
    display: none;
    margin: 0 0 0.5rem;
    color: var(--cor-secundaria);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .metodo--interativo .metodo__dica {
    display: block;
  }

  /* ---------- Rosto (line art) ---------- */
  .metodo__rosto {
    display: grid;
    gap: 0.5rem;
    justify-self: center;
    margin: 0;
    width: min(100%, 15rem);
  }

  .metodo__rosto svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .metodo__legenda {
    display: none;
    min-height: 1.5em;
    color: var(--cor-secundaria);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .metodo--interativo .metodo__legenda {
    display: block;
  }

  .base path,
  .camada path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tr-base {
    stroke: var(--cor-primaria);
    stroke-dasharray: 1 1.02;
    stroke-dashoffset: 0;
    stroke-width: 1.7;
  }

  .glow {
    stroke: var(--cor-destaque);
    stroke-width: 9;
  }

  .fio {
    stroke: var(--cor-secundaria);
    stroke-width: 1.5;
  }

  .camada--1 .glow {
    stroke-width: 12;
  }

  .camada--3 .glow {
    stroke-width: 6;
  }

  .camada--3 .fio,
  .camada--2 .fio {
    stroke-width: 1.7;
  }

  .camada--2 .glow {
    stroke-width: 6;
  }

  /* Regiões: escondidas até o ponto correspondente abrir. */
  .tr {
    opacity: 0;
    stroke-dasharray: 1 1.02;
    stroke-dashoffset: 1;
  }

  .metodo[data-ativa='1'] .camada--1 .tr,
  .metodo[data-ativa='2'] .camada--2 .tr,
  .metodo[data-ativa='3'] .camada--3 .tr,
  .metodo[data-ativa='4'] .camada--4 .tr {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Sai rápido, sem "desenhar de volta". */
    .tr {
      transition:
        opacity 0.2s ease,
        stroke-dashoffset 0s linear 0.2s;
    }

    /* Entra "desenhando" o traço, com pequeno atraso entre as linhas. */
    .metodo[data-ativa='1'] .camada--1 .tr,
    .metodo[data-ativa='2'] .camada--2 .tr,
    .metodo[data-ativa='3'] .camada--3 .tr,
    .metodo[data-ativa='4'] .camada--4 .tr {
      transition:
        opacity 0.3s ease calc(var(--i, 0) * 0.14s),
        stroke-dashoffset 1.1s ease calc(var(--i, 0) * 0.14s);
    }

    /* O desenho base também é "desenhado" quando o rosto entra na tela. */
    :global(.js:not(.js-sem-script)) .metodo__rosto:not(:global(.revelado)) .tr-base {
      stroke-dashoffset: 1;
    }

    :global(.js:not(.js-sem-script)) .tr-base {
      transition: stroke-dashoffset 1.8s ease calc(var(--b, 0) * 0.12s);
    }
  }

  /* ---------- Lista numerada ---------- */
  .ponto {
    --num-larg: 3.5rem;
    position: relative;
    border-top: 1px solid var(--cor-destaque);
  }

  .ponto:last-of-type {
    border-bottom: 1px solid var(--cor-destaque);
  }

  /* Barra lateral que cresce quando o ponto abre. */
  .ponto::before {
    position: absolute;
    top: 0.9rem;
    bottom: 0.9rem;
    left: 0;
    width: 3px;
    background: var(--cor-primaria);
    border-radius: 2px;
    content: '';
    transform: scaleY(0);
    transform-origin: top;
  }

  .ponto[open]::before {
    transform: scaleY(1);
  }

  .ponto summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 64px;
    padding: 0.9rem 0.25rem 0.9rem 1rem;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ponto summary::-webkit-details-marker {
    display: none;
  }

  .ponto__num {
    flex: none;
    min-width: var(--num-larg);
    color: var(--cor-secundaria);
    font-family: var(--fonte-titulo);
    font-size: 2.5rem;
    font-variant-numeric: lining-nums;
    font-weight: 500;
    line-height: 1;
  }

  .ponto[open] .ponto__num {
    color: var(--cor-primaria);
    transform: translateX(2px);
  }

  .ponto__titulo {
    color: var(--cor-primaria);
    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  /* Ícone + que vira − (a barra vertical some). */
  .ponto__icone {
    position: relative;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-left: auto;
    color: var(--cor-primaria);
  }

  .ponto__icone::before,
  .ponto__icone::after {
    position: absolute;
    background: currentcolor;
    border-radius: 2px;
    content: '';
  }

  .ponto__icone::before {
    top: calc(50% - 1px);
    left: 0;
    width: 100%;
    height: 2px;
  }

  .ponto__icone::after {
    top: 0;
    left: calc(50% - 1px);
    width: 2px;
    height: 100%;
  }

  .ponto[open] .ponto__icone::after {
    transform: scaleY(0);
  }

  .ponto__texto {
    margin: 0;
    padding: 0 0.25rem 1.25rem calc(1rem + var(--num-larg) + 1rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ponto::before {
      transition: transform 0.45s ease;
    }

    .ponto__num {
      transition:
        color 0.3s ease,
        transform 0.3s ease;
    }

    .ponto__titulo {
      transition: transform 0.25s ease;
    }

    .ponto__icone::after {
      transition: transform 0.35s ease;
    }

    .ponto summary {
      transition: transform 0.15s ease;
    }

    .ponto summary:active {
      transform: scale(0.985);
    }

    .ponto[open] .ponto__texto {
      animation: abrir 0.5s ease-out;
    }

    @media (hover: hover) {
      .ponto summary:hover .ponto__titulo {
        transform: translateX(4px);
      }
    }
  }

  @keyframes abrir {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .metodo__destaque {
    grid-area: destaque;
    max-width: 38rem;
    margin: 0.5rem auto 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--cor-destaque);
    color: var(--cor-primaria);
    font-family: var(--fonte-titulo);
    font-size: clamp(1.5rem, 5vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    text-wrap: balance;
  }

  /* ---------- Celular com JavaScript: painel de uma tela só (rosto + botões + texto) ---------- */
  @media (max-width: 63.999rem) {
    /* Menos respiro no celular: o rosto fica mais perto do topo e a seção não termina com um vazio. */
    .secao.metodo {
      padding-top: 2.5rem;
      padding-bottom: 2.5rem;
    }

    .metodo__grade {
      gap: 1.25rem;
    }

    /* A altura do painel é a soma do rosto, dos botões e do texto (o script mede o maior texto). */
    .metodo--interativo .metodo__painel {
      display: grid;
      gap: 0.75rem;
    }

    /* Rosto: no máximo 45% da altura da tela. */
    .metodo--interativo .metodo__rosto {
      display: block;
      width: auto;
      height: min(45vh, 19rem);
      height: min(45svh, 19rem);
      aspect-ratio: 400 / 520;
    }

    .metodo--interativo .metodo__rosto svg {
      width: 100%;
      height: 100%;
    }

    .metodo--interativo .metodo__legenda,
    .metodo--interativo .metodo__dica {
      display: none;
    }

    /* Quatro botões redondos: o ativo fica preenchido em bordô. */
    .metodo--interativo .metodo__botoes {
      display: flex;
      justify-content: center;
      gap: 0.9rem;
    }

    .metodo__botao {
      flex: none;
      width: 3rem;
      height: 3rem;
      padding: 0;
      background: transparent;
      border: 1.5px solid var(--cor-primaria);
      border-radius: 50%;
      color: var(--cor-primaria);
      cursor: pointer;
      font-family: var(--fonte-titulo);
      font-size: 1.25rem;
      font-variant-numeric: lining-nums;
      font-weight: 600;
      line-height: 1;
      -webkit-tap-highlight-color: transparent;
    }

    .metodo__botao[aria-pressed='true'] {
      background: var(--cor-primaria);
      color: var(--cor-sobre-primaria);
    }

    /* Texto: só o ponto ativo, título centralizado e sem o ícone nem o número. */
    /* Sem rolagem própria: a animação lateral nunca passa da largura da área. */
    .metodo--interativo .metodo__pontos {
      overflow: hidden;
      overflow: clip;
      text-align: center;
      touch-action: pan-y;
    }

    .metodo--interativo .ponto {
      border: 0;
    }

    .metodo--interativo .ponto:not([open]) {
      display: none;
    }

    .metodo--interativo .ponto::before,
    .metodo--interativo .ponto__num,
    .metodo--interativo .ponto__icone {
      display: none;
    }

    .metodo--interativo .ponto summary {
      min-height: 0;
      padding: 0 0 0.35rem;
      cursor: default;
      justify-content: center;
      pointer-events: none;
    }

    .metodo--interativo .ponto__texto {
      padding: 0;
    }

    @media (prefers-reduced-motion: no-preference) {
      .metodo__botao {
        transition:
          background-color 0.25s ease,
          color 0.25s ease,
          transform 0.2s ease;
      }

      .metodo__botao:active {
        transform: scale(0.92);
      }

      /* Troca de ponto: o texto entra pelo lado de onde a pessoa deslizou ou tocou. */
      .metodo--interativo .ponto[open] {
        animation: entra-prox 0.45s ease-out;
      }

      .metodo--interativo[data-direcao='ant'] .ponto[open] {
        animation-name: entra-ant;
      }

      .metodo--interativo .ponto[open] .ponto__texto {
        animation: none;
      }
    }
  }

  @keyframes entra-prox {
    from {
      opacity: 0;
      transform: translateX(28px);
    }
  }

  @keyframes entra-ant {
    from {
      opacity: 0;
      transform: translateX(-28px);
    }
  }

  @media (min-width: 64rem) {
    .metodo__grade {
      align-items: start; /* o rosto alinha pelo topo: não se move quando a lista muda de altura */
      gap: 2rem 4rem;
      grid-template-areas:
        'cab rosto'
        'pontos rosto'
        'destaque destaque';
      grid-template-columns: 1.15fr 0.85fr;
    }

    .metodo__painel {
      display: contents;
    }

    /* O rosto fica parado, alinhado pelo topo da sua coluna (sem sticky e sem acompanhar a rolagem). */
    .metodo__rosto {
      grid-area: rosto;
      align-self: start;
    }

    .metodo__pontos {
      grid-area: pontos;
    }

    .metodo__cab h2,
    .metodo__texto {
      margin-inline: 0;
      text-align: left;
    }

    .metodo__dica {
      text-align: left;
    }

    .metodo__rosto {
      width: min(100%, 24rem);
    }

    /* Respiro entre a área de duas colunas e a frase final. */
    .metodo__destaque {
      margin-top: 2.5rem;
    }

    /* ----- PC com JavaScript: todos os pontos ficam "abertos" no HTML (o texto sempre renderizado) e
       só o ponto ativo (data-ativo) expande. Assim a altura do texto anima ao abrir e ao fechar. ----- */
    .metodo--interativo .ponto__corpo {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
    }

    .metodo--interativo .ponto[data-ativo] .ponto__corpo {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }

    .metodo--interativo .ponto__corpo-interno {
      min-height: 0;
      overflow: hidden;
    }

    /* Indicadores seguem o ponto ativo, não o atributo open (que fica em todos). */
    .metodo--interativo .ponto[open]::before {
      transform: scaleY(0);
    }

    .metodo--interativo .ponto[data-ativo]::before {
      transform: scaleY(1);
    }

    .metodo--interativo .ponto[open] .ponto__num {
      color: var(--cor-secundaria);
      transform: none;
    }

    .metodo--interativo .ponto[data-ativo] .ponto__num {
      color: var(--cor-primaria);
      transform: translateX(2px);
    }

    .metodo--interativo .ponto[open] .ponto__icone::after {
      transform: scaleY(1);
    }

    .metodo--interativo .ponto[data-ativo] .ponto__icone::after {
      transform: scaleY(0);
    }
  }

  /* PC, com animação: abre e fecha em ~320ms ao mesmo tempo (a altura total da lista fica estável) e o
     destaque do rosto troca com crossfade na mesma duração. Sem animação: troca instantânea; o rosto
     continua parado de qualquer forma (alinhado pelo topo e sticky). */
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .metodo--interativo .ponto__corpo {
      transition:
        grid-template-rows 0.32s ease-out,
        opacity 0.32s ease-out,
        visibility 0s linear 0.32s;
    }

    .metodo--interativo .ponto[data-ativo] .ponto__corpo {
      transition:
        grid-template-rows 0.32s ease-out,
        opacity 0.32s ease-out,
        visibility 0s linear 0s;
    }

    .metodo--interativo .ponto[open] .ponto__texto {
      animation: none;
    }

    .tr,
    .metodo[data-ativa='1'] .camada--1 .tr,
    .metodo[data-ativa='2'] .camada--2 .tr,
    .metodo[data-ativa='3'] .camada--3 .tr,
    .metodo[data-ativa='4'] .camada--4 .tr {
      transition:
        opacity 0.32s ease-out,
        stroke-dashoffset 0.32s ease-out;
    }
  }
