---
// Seção 6: "Sobre a Gabriela". Textos em src/content/sobre.ts. Entrada ao rolar pelo sistema único (data-reveal):
// textos "subir" escalonado e foto em "zoom". O fundo (bege) e a emenda suave vêm da regra global .secao:nth-of-type(even).
import '@fontsource/pinyon-script/latin-400.css'; // só para a anotação "NaLift" (uma única palavra manuscrita)
import { sobre } from '../content/sobre';
import Seda from './Seda.astro';

// "NaLift" e "Gabriela" nunca podem ser hifenizados: nos parágrafos, ficam num span com hyphens: none.
const protegidas = /(NaLift|Gabriela)/;
const partes = (texto: string) =>
  texto.split(protegidas).map((parte) => ({ parte, protegida: protegidas.test(parte) }));

const foto = sobre.foto;
const srcset = `${foto.base}-640.webp 640w, ${foto.base}-1080.webp 1080w, ${foto.base}-1600.webp 1600w`;
---

<section class="secao sobre" id="sobre" aria-labelledby="sobre-titulo">
  <!-- Seda suave atrás da foto (decorativa, estática, bordas dissolvidas). -->
  <Seda variante="sobre" />
  <div class="secao__miolo sobre__grade">
    <div class="sobre__texto" data-reveal="escalonado">
      <p class="sobre__rotulo">{sobre.rotulo}</p>
      <h2 class="sobre__titulo" id="sobre-titulo">{sobre.titulo}</h2>
      <!-- Anotação manuscrita no "Na" de Nalin (como numa revista de moda): um traço fino sobe em arco e termina
           na palavra "NaLift". É decorativa (aria-hidden); o texto para leitores de tela vem logo abaixo. O "Na" é
           um span com position: relative e a anotação fica absoluta dentro dele, então acompanha o nome em
           qualquer tamanho de tela. -->
      <h3 class="sobre__nome">
        {sobre.nome.antes}<span class="sobre__na">{sobre.nome.na}<span class="sobre__nota" aria-hidden="true" data-reveal="gatilho"
            ><svg class="sobre__traco" viewBox="0 0 150 48" focusable="false">
              <path pathLength="1" d="M5 46 C9 31 24 21 46 19 C68 17 80 25 98 17 C106 14 110 10 114 6"></path>
            </svg><span class="sobre__nota-palavra">{sobre.nota}</span></span
          ></span
        ><span class="sobre__resto">{sobre.nome.depois}</span>
      </h3>
      <p class="sobre__cargo">{sobre.cargo}</p>
      <p class="sr-somente">{sobre.notaLeitor}</p>
      {
        sobre.paragrafos.map((texto) => (
          <p class="sobre__paragrafo">
            {partes(texto).map((p) => (p.protegida ? <span class="sem-hifen">{p.parte}</span> : p.parte))}
          </p>
        ))
      }
      <p class="sobre__ligacao">
        {partes(sobre.ligacao).map((p) => (p.protegida ? <span class="sem-hifen">{p.parte}</span> : p.parte))}
      </p>
      <p class="sobre__rodape">
        <span class="sobre__registro">{sobre.rodape.registro}</span><span class="sobre__sep"> · </span><span
          class="sobre__especialidade">{sobre.rodape.titulo}</span
        >
      </p>
    </div>

    <!-- [PROVISÓRIO] Foto provisória (será trocada por um retrato profissional). -->
    <div class="sobre__foto" data-reveal="zoom">
      <div class="sobre__cartao">
        <picture>
          <source type="image/webp" srcset={srcset} sizes="(min-width: 64rem) 34rem, (min-width: 40rem) 24rem, 90vw" />
          <img
            src={`${foto.base}-1080.jpg`}
            alt={foto.alt}
            width={foto.largura}
            height={foto.altura}
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
      <!-- Selo sobreposto no canto inferior esquerdo (repete "Enfermeira Esteta" do texto: decorativo). -->
      <div class="sobre__selo" aria-hidden="true">
        <span class="sobre__selo-titulo">{sobre.selo.titulo}</span>
        <span class="sobre__selo-sub">{sobre.selo.subtitulo}</span>
      </div>
    </div>
  </div>
</section>

<style>
  /* A seda (Seda.astro) fica atrás de tudo: a seção é a referência de posição e o texto e a foto ficam acima dela. */
  .sobre {
    position: relative;
    overflow-x: clip;
  }

  .sobre__texto {
    position: relative;
    z-index: 1;
  }

  /* Celular: foto em cima (com o selo), texto embaixo. */
  .sobre__grade {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .sobre__foto {
    position: relative;
    z-index: 1;
    order: -1;
    width: min(100%, 24rem);
    margin-inline: auto;
  }

  .sobre__cartao {
    overflow: hidden;
    background: var(--cor-fundo);
    border-radius: 32px;
    box-shadow: var(--sombra-suave);
  }

  .sobre__cartao img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  /* Selo: fundo nude, sombra suave, "Enfermeira" em EB Garamond bordô e "ESTETA" pequeno embaixo. */
  .sobre__selo {
    position: absolute;
    bottom: 1.75rem;
    left: -0.5rem; /* dentro da margem lateral da página: não cria rolagem horizontal */
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.75rem 1.25rem 0.7rem;
    background: var(--cor-fundo);
    border-radius: 18px;
    box-shadow: 0 10px 28px color-mix(in srgb, var(--cor-texto) 16%, transparent);
    line-height: 1.1;
  }

  .sobre__selo-titulo {
    color: var(--cor-primaria);
    font-family: var(--fonte-titulo);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .sobre__selo-sub {
    margin-top: 0.3rem;
    color: var(--cor-secundaria);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-indent: 0.3em; /* compensa o espaçamento depois da última letra, para o texto ficar centralizado */
    text-transform: uppercase;
  }

  .sobre__rotulo {
    margin: 0 0 0.75rem;
    color: var(--cor-secundaria);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sobre__titulo {
    margin-bottom: 1.25rem;
  }

  /* Nome: cor normal do texto, só o "Na" de Nalin em bordô. Nunca quebra linha. O espaço acima (2,4em, em
     proporção ao tamanho do nome) é reservado para a anotação manuscrita (1,5em de altura + folga) não encostar
     no título nem sair da tela, em qualquer tamanho. */
  .sobre__nome {
    margin: 2.4em 0 0;
    color: var(--cor-texto);
    font-size: clamp(1.625rem, 5vw, 2rem);
    font-weight: 500;
    white-space: nowrap;
  }

  /* Só as letras "Na" em bordô (e a anotação sai delas); o "lin" volta para a cor normal do nome. */
  .sobre__na {
    position: relative;
    color: var(--cor-primaria);
  }

  .sobre__resto {
    color: var(--cor-texto);
  }

  /* Anotação (decorativa): tamanho em em, relativo ao nome; fica sobre o "Na" e sobe em arco para a direita. */
  .sobre__nota {
    position: absolute;
    bottom: calc(100% - 0.2em);
    left: 0.4em;
    display: block;
    width: 4.6em;
    height: 1.5em;
    font-size: 1em;
    pointer-events: none;
  }

  .sobre__traco {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--cor-secundaria);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5; /* unidades do desenho: ~1,1 a 1,4 px na tela */
  }

  /* "NaLift": uma única palavra em Pinyon Script (manuscrita elegante, no espírito do W cursivo do logo), pequena,
     bordô, levemente inclinada, na ponta do traço. */
  .sobre__nota-palavra {
    position: absolute;
    top: -0.05em;
    left: 77%;
    color: var(--cor-primaria);
    font-family: 'Pinyon Script', var(--fonte-titulo), cursive;
    font-size: 0.78em;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transform: rotate(-7deg);
    transform-origin: left bottom;
  }

  .sobre__cargo {
    margin: 0.15rem 0 1.5rem;
    color: var(--cor-secundaria);
    font-family: var(--fonte-titulo);
    font-size: 1.25rem;
    font-style: italic;
    font-weight: 500;
  }

  /* Quebra de linha dos parágrafos (decisão do usuário, só nesta seção): alinhados à esquerda, com text-wrap: pretty
     (evita linhas finais curtas e bordas muito irregulares) e hifenização automática em português (o <html> tem
     lang="pt-BR"). hyphenate-limit-chars evita hifens que deixam só 1 ou 2 letras de cada lado. Sem nenhum outro
     ajuste de quebra (nada de <wbr>, espaços não separáveis ou text-wrap: balance nos parágrafos). */
  .sobre__paragrafo,
  .sobre__ligacao {
    max-width: 34rem;
    hyphenate-limit-chars: 6 3 3;
    hyphens: auto;
    text-align: left;
    text-wrap: pretty;
  }

  .sobre__ligacao {
    margin-bottom: 1.75rem;
  }

  /* Nunca hifenizar "NaLift" nem "Gabriela" (nem o nome e a anotação, que também não quebram linha). */
  .sem-hifen,
  .sobre__nome,
  .sobre__nota-palavra {
    hyphens: none;
  }

  /* Títulos: texto equilibrado entre as linhas. */
  .sobre__titulo,
  .sobre__nome {
    text-wrap: balance;
  }

  /* Rodapé do bloco (COREN): um detalhe, não pode competir com o texto. Cinza-marrom suave (texto da paleta a 74%:
     contraste ~4,6 para 1 no bege, ainda AA). Celular (decisão do usuário): letra menor (12,5px), menos espaçamento
     entre letras e quebra elegante em duas linhas (registro / especialidade, sem o ponto). A partir do tablet: 14px e
     numa linha só, com o ponto. */
  .sobre__rodape {
    margin: 0;
    color: color-mix(in srgb, var(--cor-texto) 74%, var(--cor-fundo));
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    line-height: 1.6;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .sobre__registro {
    display: block;
  }

  .sobre__sep {
    display: none;
  }

  @media (min-width: 48rem) {
    .sobre__rodape {
      font-size: 0.875rem;
      letter-spacing: 0.12em;
    }

    .sobre__registro {
      display: inline;
    }

    .sobre__sep {
      display: inline;
    }
  }

  /* PC: texto à esquerda e foto à direita, alinhados pelo centro. */
  @media (min-width: 64rem) {
    .sobre__grade {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 4.5rem;
    }

    .sobre__foto {
      order: 0;
      width: min(100%, 30rem);
      margin-inline: 0;
      justify-self: end;
    }

    .sobre__selo {
      left: -1.75rem;
      bottom: 2.25rem;
    }
  }
</style>
